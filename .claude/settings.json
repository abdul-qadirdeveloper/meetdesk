{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit",
      "hooks": [{ "type": "command", "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"" }] }],
    "PreToolUse": [{ "matcher": "Bash",
      "hooks": [{ "type": "command", "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash_guard.py\"" }] }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/test_gate.py\"" }] }],
    "SessionStart": [{ "matcher": "compact",
      "hooks": [{ "type": "command", "command": "uv run python \"$CLAUDE_PROJECT_DIR/.claude/hooks/restore_state.py\"" }] }]
  }
}